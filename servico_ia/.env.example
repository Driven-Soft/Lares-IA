# Copie para .env (que não vai para o git) e preencha.

# Chave da OpenAI. Sem ela, o serviço classifica só pelas regras de palavra-chave.
OPENAI_API_KEY=

# Modelo da OpenAI usado na triagem.
OPENAI_MODEL=gpt-4.1-mini

# Tempo máximo de espera pela OpenAI, em segundos.
OPENAI_TIMEOUT=10

# Chave que a API Java manda no header X-API-Key.
# Vazia = endpoint aberto (só para rodar local). No Render, defina uma chave.
LARES_IA_API_KEY=
